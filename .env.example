# ── Stellar network ───────────────────────────────────────────────────────────
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NOTIFY_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/stellarnotify

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API server ────────────────────────────────────────────────────────────────
PORT=3001
API_SECRET=change_me_in_production_min_32_chars

# ── Webhook dispatcher ────────────────────────────────────────────────────────
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY_MS=2000

# ── Event ingestion ───────────────────────────────────────────────────────────
POLL_INTERVAL_MS=6000

# ── Logging ───────────────────────────────────────────────────────────────────
# Levels: error | warn | info | debug
LOG_LEVEL=info
