{
  "name": "stellarnotify-backend",
  "version": "0.1.0",
  "description": "StellarNotify backend — event ingester, webhook dispatcher, in-app broadcaster, REST API",
  "license": "MIT",
  "private": true,
  "author": "StellarNotify Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/stellarnotify-backend"
  },
  "keywords": ["stellar", "soroban", "notifications", "webhooks", "typescript"],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "12.3.0",
    "axios": "1.7.9",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "pg": "8.13.3",
    "redis": "4.7.0",
    "winston": "3.17.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.19",
    "@types/pg": "8.11.11",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node-dev": "2.0.0",
    "typescript": "5.7.3"
  }
}
